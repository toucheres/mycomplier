

void write(char in)
{
    _asm_("LEA 16");
    _asm_("LW");
    _asm_("SYSTEMCALL 0");
    return;
}
void print_str(char* str)
{
    while (*str != '\0')
    {
        write(*str);
        str = str + 1;
    }
    return;
}
int main()
{
    char arr[15] = {'h', 'e', 'l', 'l', 'o', ',', ' ', 'w', 'o', 'r', 'l', 'd', '!', '\n', '\0'};
    print_str(arr);
    return 0;
}
