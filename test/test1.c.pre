


long align_up(long num, long align)
{
    if (num % align == 0)
    {
        return num;
    }
    else
    {
        return num + (align - num % align);
    }
};
char* va_arg_fun(char** ap, int size)
{
    char* tp = *ap;
    (*ap) += align_up(size, 8); 
    return tp;
}

typedef long size_t;
long strlen(char* str)
{
    long lenth = 0;
    while (*str != 0)
    {
        lenth = lenth + 1;
        str = str + 1;
    }
    return lenth;
}
char* strcpy(char* to, char* from)
{
    char* tmp = to;
    while (*from != 0)
    {
        *to = *from;
        from++;
        to++;
    }
    return tmp;
}
int strcmp(char* str1, char* str2)
{
    int ret = 0;
    while (!(ret = *str1 - *str2) && *str1)
    {
        str1++;
        str2++;
    }
    if (ret < 0)
    {
        return -1;
    }
    else if (ret > 0)
    {
        return 1;
    }
    return 0;
}
char* memmove(char* des, char* src, size_t n)
{
    for (size_t i = 0; i < n; i++)
    {
        des[i] = src[i];
    }
    return des;
}

