
long align_up(long num, long align)
{
    if (num % align == 0)
    {
        return num;
    }
    else
    {
        return num + (align - num % align);
    }
};
char* va_arg_fun(char** ap, int size)
{
    char* tp = *ap;
    (*ap) += align_up(size, 8); 
    return tp;
}

int varfunctest(char* base, ...)
{
    char* ap;
    (ap = (long)&base + align_up(sizeof(base),8)); 

    int arg1 = (*((int*)va_arg_fun(&ap, sizeof(int)))); 
    int arg2 = (*((int*)va_arg_fun(&ap, sizeof(int)))); 

    0;; 
    return arg2;
}
int main()
{
    return varfunctest("nothing", 1, 2);
}
