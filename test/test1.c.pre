

void write(char in)
{
    _asm_("IMM 16");
    _asm_("LEA");
    _asm_("LW");
    _asm_("SYSTEMCALL 0");
    return;
}
void print_str(char* str)
{
    while (*str != '\0')
    {
        write(*str);
        str = str + 1;
    }
    return;
}
int main()
{
    char arr[5] = {'a', 'b', 'c', '\n', '\0'};
    char* ptr = arr;
    while (*ptr != '\0')
    {
        write(*ptr);
        ptr = ptr + 1;
    }
    return 0;
}
