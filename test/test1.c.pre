long printf(char* fmt, ...)
{
    long argindex = 1;
    long chars = 0;

    while (*fmt != '\0')
    {
        if (*fmt == '%')
        {
            fmt++;
            if (*fmt == '\0')
                break;

            
            if (*fmt == '%')
            {
                __write('%');
                chars++;
                fmt = fmt + 1;
                continue;
            }

            if (*fmt == 'c')
            {
                long c = *load_arg_ptr(&fmt, argindex);
                argindex = argindex + 1;
                __write(c);
                chars++;
                fmt = fmt + 1;
            }
            else if (*fmt == 'd')
            {
                long v = *load_arg_ptr(&fmt, argindex); 
                argindex = argindex + 1;
                char buf[32];
                long n = num_to_str(buf, v);
                for (long i = 0; i < n; ++i)
                {
                    __write(buf[i]);
                }
                chars += n;
                fmt = fmt + 1;
            }
            else if (*fmt == 'l')
            {
                fmt = fmt + 1;
                if (*fmt == 'd')
                {
                    long v = *load_arg_ptr(&fmt, argindex);
                    argindex = argindex + 1;
                    char buf[32];
                    long n = num_to_str(buf, v);
                    for (long i = 0; i < n; ++i)
                    {
                        __write(buf[i]);
                    }
                    chars += n;
                    fmt = fmt + 1;
                }
                else
                {
                    
                    __write('%');
                    chars++;
                    __write('l');
                    chars++;
                    if (*fmt != '\0')
                    {
                        __write(*fmt);
                        chars++;
                        fmt = fmt + 1;
                    }
                }
            }
            else if (*fmt == 's')
            {
                char* s = *load_arg_ptr(&fmt, argindex);
                argindex = argindex + 1;
                while (s && *s)
                {
                    __write(*s);
                    chars++;
                    s++;
                }
                fmt = fmt + 1;
            }
            else
            {
                
                __write('%');
                chars++;
                if (*fmt != '\0')
                {
                    __write(*fmt);
                    chars++;
                    fmt = fmt + 1;
                }
            }
        }
        else
        {
            __write(*fmt);
            chars++;
            fmt = fmt + 1;
        }
        fmt = fmt + 1;
    }
    return chars;
}

int main()
{
    int arr[3] = {122,13,45};
    int* ptr = arr;
    ptr++;
    return ptr[1];
}
