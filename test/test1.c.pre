

void write(char in)
{
    _asm_("IMM 16");
    _asm_("LEA");
    _asm_("LW");
    _asm_("SYSTEMCALL 0");
    _asm_("POP");
    return;
}
void print_str(char* str)
{
    while (*str != '\0')
    {
        write(*str);
        str = str + 1;
    }
    return;
}
long fun(int arg, ...)
{
    char a;
    a = 97;
    
    return 97;
}
int main()
{
    long a;
    a = fun(3, 6, 97, 8);
    return 1;
}
