

void write(char in)
{
    _asm_("IMM 16");
    _asm_("LEA");
    _asm_("LW");
    _asm_("SYSTEMCALL 0");
    return;
}
void print_str(char* str)
{
    while (*str != '\0')
    {
        write(*str);
        str = str + 1;
    }
    return;
}












int main()
{
    
    int arr[3] = {'a','b','c'};
    int* p = arr;
    write(*p);
    write(*(p+1));
    return 0;
}
