void write(long arg)
{
    return __write(arg);
}
long print_str(char* str)
{
    long num = 0;
    while (*str != '\0')
    {
        write(*str);
        str++;
        num++;
    }
    return num;
}
long num_to_str(char* src, long num)
{
    
    if (num == 0)
    {
        *src = '0';
        return 1;
    }
    if (num < 0)
    {
        *src = '-';
        long len = num_to_str(src + 1, -num);
        return len + 1;
    }

    
    if (num < 10)
    {
        *src = '0' + num;
        return 1;
    }
    else
    {
        long higher = num / 10;
        long rem = num % 10;
        long len = num_to_str(src, higher);
        *(src + len) = '0' + rem;
        return len + 1;
    }
}

long vsprintf(char* dst, char* fmt, char* ap)
{
    char* src = dst;
    long charsnum = 0;

    while (*fmt != 0)
    {
        if (*fmt == '%')
        {
            fmt = fmt + 1;
            if (*fmt == 'c')
            {
                char ch = (*((int*)va_arg_fun(&ap, sizeof(int)))); 
                *src = ch;
                charsnum = charsnum + 1;
                fmt = fmt + 1;
                src = src + 1;
            }
            else if (*fmt == 'd')
            {
                int val = (*((int*)va_arg_fun(&ap, sizeof(int))));
                long size = num_to_str(src, val);
                charsnum = charsnum + size;
                fmt = fmt + 1;
                src = src + size;
            }
            else if (*fmt == 's')
            {
                char* str = (*((char**)va_arg_fun(&ap, sizeof(char*))));
                while (*str != '\0')
                {
                    *src = *str;
                    src = src + 1;
                    str = str + 1;
                    charsnum = charsnum + 1;
                }
                fmt = fmt + 1;
            }
            else if (*fmt == 'l')
            {
                fmt = fmt + 1;
                if (*fmt == 'd')
                {
                    long val = (*((long*)va_arg_fun(&ap, sizeof(long))));
                    long size = num_to_str(src, val);
                    charsnum = charsnum + size;
                    fmt = fmt + 1;
                    src = src + size;
                }
                else
                {
                    *src = 'l';
                    src = src + 1;
                    charsnum = charsnum + 1;
                    
                }
            }
            else if (*fmt == 'p')
            {
                
                long val = (*((long*)va_arg_fun(&ap, sizeof(long))));
                *src++ = '0';
                *src++ = 'x';
                charsnum = charsnum + 2;
                
                long size = num_to_str(src, val);
                charsnum = charsnum + size;
                src = src + size;
                fmt = fmt + 1;
            }
            else if (*fmt == '%')
            {
                *src = '%';
                src = src + 1;
                charsnum = charsnum + 1;
                fmt = fmt + 1;
            }
            else
            {
                
                *src++ = '%';
                charsnum++;
                if (*fmt != '\0')
                {
                    *src++ = *fmt;
                    charsnum++;
                    fmt++;
                }
            }
        }
        else
        {
            *src = *fmt;
            charsnum = charsnum + 1;
            fmt = fmt + 1;
            src = src + 1;
        }
    }
    *src = '\0';
    return charsnum;
}

long sprintf(char* dst, char* fmt, ...)
{
    char* ap;
    (ap = (char*)((long)&fmt + align_up(sizeof(fmt), 8)));
    long ret = vsprintf(dst, fmt, ap);
    0;;
    return ret;
}

long vprintf(char* fmt, char* ap)
{
    char buf[1024]; 
    long len = vsprintf(buf, fmt, ap);
    print_str(buf);
    return len;
}

long printf(char* fmt, ...)
{
    char* ap;
    (ap = (char*)((long)&fmt + align_up(sizeof(fmt), 8)));
    long ret = vprintf(fmt, ap);
    0;;
    return ret;
}

typedef struct FILE_struct
{
    int _flags; 

    
    char* _IO_read_ptr;   
    char* _IO_read_end;   
    char* _IO_read_base;  
    char* _IO_write_base; 
    char* _IO_write_ptr;  
    char* _IO_write_end;  
    char* _IO_buf_base;   
    char* _IO_buf_end;    

    
    char* _IO_save_base;   
    char* _IO_backup_base; 
    char* _IO_save_end;    

    long _markers;

    long _chain; 

    int _fileno;
    int _flags2;
    long _old_offset; 

    
    short _cur_column;
    char _vtable_offset;
    char _shortbuf[1];

    long _lock;
} FILE;

FILE* fopen(char* filename, char* modes)
{
    return (FILE*)__open(filename, modes);
}

int fclose(FILE* fp)
{
    return __close((long)fp);
}
int fputc(int c, FILE* fp)
{
    return __putc(c, (long)fp);
}
int fputs(char* s, FILE* fp)
{
    int size = 0;
    for (int i = 0; i < strlen(s); i++)
    {
        if (fputc(s[i], fp) != -1)
        {
            size++;
        }
        else
        {
            return -1;
        }
    }
    return size;
}
int fgetc(FILE* fp)
{
    return __getc((long)fp);
}
char* fgets(char* buf, int n, FILE* fp)
{
    if (n <= 0)
    {
        return 0;
    }
    int i = 0;
    int c;
    while (i < n - 1)
    {
        c = fgetc(fp);
        if (c == -1)
        {
            if (i == 0)
            {
                return 0; 
            }
            break;
        }
        buf[i] = (char)c;
        i++;
        if (c == '\n')
        {
            break;
        }
    }
    buf[i] = '\0';
    return buf;
}

size_t fread(void* ptr, size_t size_of_elements, size_t number_of_elements, FILE* a_file)
{
    size_t total = size_of_elements * number_of_elements;
    size_t bytes_read = __read((long)a_file, (char*)ptr, (long)total);
    return bytes_read / size_of_elements;
}

size_t fwrite(void* ptr, size_t size_of_elements, size_t number_of_elements, FILE* a_file)
{
    size_t total = size_of_elements * number_of_elements;
    size_t bytes_written = __write_file((long)a_file, (char*)ptr, total);
    return bytes_written / size_of_elements;
}
