enum
{
    IMM,
    LEA,
    JMP,
    JZ,
    JNZ,
    CALL,
    NVAR,
    DARG,
    RET,
    LI,
    LC,
    SI,
    SC,
    PUSH,
    OR,
    XOR,
    AND,
    EQ,
    NE,
