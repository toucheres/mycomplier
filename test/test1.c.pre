
void write(char in)
{
    _asm_("LEA 16");
    _asm_("LW");
    _asm_("SYSTEMCALL 0");
    return;
}
int main()
{
    char arr[15] = {'h', 'e', 'l', 'l', 'o', ',', ' ', 'w', 'o', 'r', 'l', 'd', '!', '\n', '\0'};
    char* ptr = arr;
    while (*ptr != '\0')
    {
        write(*ptr);
        ptr = ptr + 1;
    }
    return 0;
}
