# 主要 PEG 语法元素
# 'abc' 或 "abc" - 字面量字符串
# A B - 顺序（先 A 后 B）
# A / B - 优先选择（先尝试 A，失败则尝试 B）
# A* - 重复零次或多次
# A+ - 重复一次或多次
# A? - 可选（零次或一次）
# &A - 正向预测（不消耗输入）
# !A - 负向预测（不消耗输入）
# [a-zA-Z] - 字符类
# [^abc] - 否定字符类
# < ... > - Token 边界（捕获为标记）
# {2,5} - 重复 2-5 次
# %whitespace - 自动忽略空白规则

# 主入口点
Program    <- (symbalDecl)*

# 全局
symbalDecl <- linkOption* ( VarDecl / FuncDef / VarDefWithInit )
VarDecl <- idDecl ';'
FuncDef <- idDecl Block
VarDefWithInit <- idDecl '=' (Expression / initBlock) ';'
linkOption  <- 'extern' / 'static'
initBlock <- '{' (Expression / initBlock)? (',' (Expression / initBlock))* '}'
# 基础元素定义
# 标识符
Identifier <- < [a-zA-Z_][a-zA-Z0-9_]* >
Number         <- < [0-9]+ >
String         <- '"' < (!'"' .)* > '"'
# 语句块和控制结构
Block       <- '{' Statement* '}'
Statement   <-  ContinueStmt / BreakStmt / WhileStmt / VarDecl / VarDefWithInit / ReturnStmt / ExprStmt / IfStmt /  Block
ReturnStmt  <- 'return' Expression? ';'
ExprStmt    <- Expression ';'
IfStmt      <- 'if' '(' Expression ')' Statement ('else' Statement)?
WhileStmt   <- 'while' '(' Expression ')' Statement
BreakStmt   <- 'break' ';'
ContinueStmt <- 'continue' ';'

# 类型系统 - 完全重写以支持复杂类型
idDecl           <- TypeSpecifier Declarator
TypeSpecifier  <- BasicType
BasicType      <- 'int' / 'char' / 'void' / 'float' / 'double' / 'long' / 'short' / 'unsigned' / 'signed'

# 声明符 - 采用后缀模式避免左递归问题
Declarator     <- Pointer? DirectDeclarator
Pointer        <- '*'+

# 直接声明符 - 基础标识符或带括号的复杂声明符
DirectDeclarator <- (
                     Identifier 
                     / '(' Declarator ')'
                   ) 
                   DirectDeclaratorSuffix*

# 声明符后缀 - 处理数组和函数类型
DirectDeclaratorSuffix <- ArraySuffix / FunctionSuffix

# 数组后缀 - 可以有空括号或带表达式的括号
ArraySuffix    <- '[' Expression? ']'

# 函数后缀 - 参数列表可选
FunctionSuffix <- '(' ParameterTypeList? ')'

# 参数类型列表
ParameterTypeList <- Parameter (',' Parameter)* (',' '...')?

# 参数声明 - 允许带名称或匿名参数
Parameter      <- TypeSpecifier (Declarator / AbstractidDecl)?

# 抽象声明符 - 用于没有标识符的类型声明（如函数参数）
AbstractidDecl <- Pointer? AbstractDirectDeclarator / Pointer

# 抽象直接声明符 - 不含标识符的复杂类型
AbstractDirectDeclarator <- (
                            '(' AbstractidDecl ')'
                           ) 
                           DirectDeclaratorSuffix*
                           / DirectDeclaratorSuffix+

# 忽略空白
_  <- [ \t\r\n]*
%whitespace <- [ \t\r\n]*

# 表达式
Expression          <- Assignment

Assignment          <- Conditional (ASSIGN Assignment)? 
ASSIGN              <-  '=' / '+=' / '-=' / '*=' / '/=' / '%=' / '&=' / '|=' / '^=' / '<<=' / '>>='

Conditional         <- LogicalOr ('?' Expression ':' Conditional)?

LogicalOr           <- LogicalAnd (LogicalOr_op LogicalAnd)*
LogicalOr_op        <- '||'

LogicalAnd            <- BitwiseOr (LogicalAnd_op BitwiseOr)*
LogicalAnd_op          <- '&&'

BitwiseOr             <- BitwiseXor (BitwiseOr_op BitwiseXor)*
BitwiseOr_op            <- '|'

BitwiseXor            <- BitwiseAnd (BitwiseXor_op BitwiseAnd)*
BitwiseXor_op           <- '^'

BitwiseAnd            <- Equality (BitwiseAnd_op Equality)*
BitwiseAnd_op           <- '&'

Equality               <- Relational (Equality_op Relational)*
Equality_op           <-'==' / '!='

Relational            <- Shift (Relational_op Shift)*
Relational_op         <- '<' / '>' / '<=' / '>='

Shift                 <- Additive (Shift_op Additive)*
Shift_op              <- '<<' / '>>'

Additive             <- Multiplicative (Additive_op Multiplicative)*
Additive_op             <- '+' / '-'

Multiplicative      <- Cast (Multiplicative_op Cast)*
Multiplicative_op   <-'*' / '/' / '%'

Cast                <- '(' idDecl ')' Cast / Unary
# 右递归解析前缀
Unary          <- Unary_op Unary / Postfix
Unary_op          <- '+' / '-' / '!' / '~' / '++' / '--' / '*' / '&'

Postfix        <- Primary Postfix_content*
Postfix_content <- '(' Args? ')' / '[' Expression ']' / '.' Identifier / '->' Identifier / '++' / '--'
Primary        <- Identifier / Number / String / '(' Expression ')'
Args           <- Expression (',' Expression)*