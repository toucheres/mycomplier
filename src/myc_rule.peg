# 主要 PEG 语法元素
# 'abc' 或 "abc" - 字面量字符串
# A B - 顺序（先 A 后 B）
# A / B - 优先选择（先尝试 A，失败则尝试 B）
# A* - 重复零次或多次
# A+ - 重复一次或多次
# A? - 可选（零次或一次）
# &A - 正向预测（不消耗输入）
# !A - 负向预测（不消耗输入）
# [a-zA-Z] - 字符类
# [^abc] - 否定字符类
# < ... > - Token 边界（捕获为标记）
# {2,5} - 重复 2-5 次
# %whitespace - 自动忽略空白规则

# 主入口点
Program    <- (GlobalVarDef / FuncDef / GlobalVarDecl / FuncDecl)*
# Program    <- Global*
# Global     <- (GlobalVarDef / FuncDef / GlobalVarDecl / FuncDecl)

# 全局
GlobalVarDef    <- VarDef
GlobalVarDecl   <- VarDecl

# 基础元素定义
# 标识符
Identifier <- < [a-zA-Z_][a-zA-Z0-9_]* >
Number         <- < [0-9]+ >
String         <- '"' < (!'"' .)* > '"'
# 形参
Args           <- Expression (',' Expression)*
ASSIGN         <- < '=' / '+=' / '-=' / '*=' / '/=' / '%=' / '&=' / '|=' / '^=' / '<<=' / '>>=' >
  
# 变量声明/定义
VarDef    <- Type Identifier ';' / Type Identifier '=' Expression ';'
VarDecl    <- 'extern' Type Identifier ';'

# 函数声明/定义
FuncDef     <- Type Identifier '(' FunArgs? ')' Block
FuncDecl    <- Type Identifier '(' FunArgs? ')' ';'
#实参
FunArgs     <- Arg (',' Arg)*
Arg         <- Type Identifier
Block       <- '{' Statement* '}'
Statement   <- VarDef / ReturnStmt / ExprStmt / IfStmt / WhileStmt / BreakStmt / ContinueStmt / Block
ReturnStmt  <- 'return' Expression? ';'
ExprStmt    <- Expression ';'
# 控制结构
IfStmt      <- 'if' '(' Expression ')' Statement ('else' Statement)?
WhileStmt   <- 'while' '(' Expression ')' Statement
BreakStmt  <- 'break' ';'
ContinueStmt <- 'continue' ';'
# ForStmt     <- 'for' '(' (VarDef / ExprStmt / ';') Expression? ';' Expression? ')' Statement
# DoWhileStmt <- 'do' Statement 'while' '(' Expression ')' ';'

# 类型
Type       <- BasicType Pointer?
BasicType  <- 'int' / 'char' / 'void'  # 添加 void 支持
Pointer    <- '*'+


# 忽略空白
_  <- [ \t\r\n]*
%whitespace <- [ \t\r\n]*

# 表达式
Expression          <- Assignment
Assignment          <- Conditional (ASSIGN Assignment)? 
Conditional         <- LogicalOr ('?' Expression ':' Conditional)?
LogicalOr           <- LogicalAnd ('||' LogicalAnd)*
LogicalAnd            <- BitwiseOr ('&&' BitwiseOr)*
BitwiseOr             <- BitwiseXor ('|' BitwiseXor)*
BitwiseXor            <- BitwiseAnd ('^' BitwiseAnd)*
BitwiseAnd            <- Equality ('&' Equality)*
Equality               <- Relational (Equality_op Relational)*
Equality_op           <-'==' / '!='
Relational            <- Shift (Relational_op Shift)*
Relational_op         <- '<' / '>' / '<=' / '>='
Shift                 <- Additive (Shift_op Additive)*
Shift_op              <- '<<' / '>>'
Additive             <- Multiplicative (Additive_op Multiplicative)*
Additive_op             <- '+' / '-'
Multiplicative      <- Cast (Multiplicative_op Cast)*
Multiplicative_op   <-'*' / '/' / '%'
Cast                <- '(' Type ')' Cast / Unary
# 右递归解析前缀
Unary          <- Unary_op Unary / Postfix
Unary_op          <- '+' / '-' / '!' / '~' / '++' / '--' / '*' / '&'
# 避免左递归，用后缀循环代替
Postfix        <- Primary Postfix_content*
Postfix_content <- '(' Args? ')' / '[' Expression ']' / '.' Identifier / '->' Identifier / '++' / '--'
# 区分Primary:Identifier的 funcall 与 varref会 造成FunctionCall 与 VariableRef + Postfix 的冲突
# 因此不在ast中区分varref 与 funccall
Primary        <- Identifier / Number / String / '(' Expression ')'